{
  "name": "@seafood-pos/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate --schema ../../prisma/schema.prisma && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint src",
    "test": "prisma generate --schema ../../prisma/schema.prisma && jest",
    "type-check": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.20.0",
    "@seafood-pos/schemas": "workspace:*",
    "@seafood-pos/utils": "workspace:*",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.4.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
