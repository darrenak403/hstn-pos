# --- Database ---
DATABASE_URL="postgresql://pos:pos@localhost:5432/seafood_pos?schema=public"

# --- Auth ---
# Ký access token (JWT). Đổi giá trị thật khi deploy, không commit secret thật.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL_SECONDS=28800
# HMAC pepper để băm refresh token (tra cứu quyết định, không phải bcrypt vì cần tra cứu bằng hash)
JWT_REFRESH_PEPPER="change-me-refresh-pepper"
JWT_REFRESH_TTL_DAYS=30
# Cửa sổ ân hạn khi xoay refresh token (giây) — xem apps/api/src/auth/refresh-token.repository.ts
REFRESH_GRACE_SECONDS=30
# "log" = chỉ ghi AuditLog khi phát hiện tái sử dụng, không thu hồi gì (bake-in tối thiểu 2 tuần)
# "enforce" = thu hồi toàn bộ family token khi phát hiện tái sử dụng thật
AUTH_REUSE_DETECTION_MODE="log"
# Khoá AES-256-GCM (base64, PHẢI giải mã ra đúng 32 byte) mã hoá token tạm trong
# bảng RefreshTokenGrace — xem apps/api/src/auth/grace-encryption.ts. Giá trị dưới
# đây KHÔNG hợp lệ (cố ý) để buộc tạo khoá thật trước khi chạy: openssl rand -base64 32
AUTH_GRACE_ENCRYPTION_KEY="change-me: openssl rand -base64 32"

# --- Seed ---
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-on-first-login"

# --- API ---
PORT=3000
# Danh sách origin của CLIENT (app Tauri/web) được phép gọi API, phân tách bởi dấu
# phẩy — KHÔNG phải domain của API server. Mặc định bao gồm origin app Tauri đã
# đóng gói (tauri://localhost trên macOS/Linux, http(s)://tauri.localhost trên
# Windows WebView2). Thêm origin dev server (vd. http://localhost:1420) khi cần.
CORS_ORIGIN="tauri://localhost,http://tauri.localhost,https://tauri.localhost"
